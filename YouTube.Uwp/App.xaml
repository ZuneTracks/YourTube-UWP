<Application
    x:Class="YouTube.Uwp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PhonePageBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="PhoneHeaderBrush" Color="#FF353535" />
        <SolidColorBrush x:Key="PhoneSurfaceBrush" Color="#FF2C2C2C" />
        <SolidColorBrush x:Key="PhoneCardBrush" Color="#FF383838" />
        <SolidColorBrush x:Key="PhoneAccentBrush" Color="#FFAC2A26" />
        <SolidColorBrush x:Key="PhoneHighlightBrush" Color="#FF4D83BE" />
        <SolidColorBrush x:Key="PhonePrimaryTextBrush" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="PhoneSecondaryTextBrush" Color="#FFC6C6C6" />
        <SolidColorBrush x:Key="PhoneMutedTextBrush" Color="#FF989898" />

        <Style x:Key="PhonePageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Light" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiLight" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
        </Style>
        <Style x:Key="PhoneSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Light" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiLight" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
        </Style>
        <Style x:Key="PhoneCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
        </Style>
        <Style x:Key="PhoneMetadataStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PhoneMutedTextBrush}" />
        </Style>
        <Style x:Key="PhonePivotHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semilight" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PhoneSecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style x:Key="PhoneActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PhoneAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9,14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PhoneOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PhoneMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9,14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PhoneTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PhoneSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PhoneMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7,10,7" />
            <Setter Property="Margin" Value="0,6,0,10" />
        </Style>
        <Style x:Key="PhonePasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource PhoneSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PhonePrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PhoneMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7,10,7" />
            <Setter Property="Margin" Value="0,6,0,10" />
        </Style>
        <Style x:Key="PhoneListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Application.Resources>
</Application>
