<Page
    x:Class="YouTube.Uwp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="‹ BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="settings" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="16,18,16,28">
                <TextBlock Text="settings" Style="{StaticResource PhonePageTitleStyle}" />
                <TextBlock Text="Personal credentials are stored only in Windows Credential Locker." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,18" TextWrapping="Wrap" />

                <Border Background="{StaticResource PhoneSurfaceBrush}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="public data access" Style="{StaticResource PhoneSectionTitleStyle}" />
                        <TextBlock Text="A restricted API key is used only for read-only YouTube Data API v3 calls." Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource PhonePasswordBoxStyle}" Header="Google API key" PlaceholderText="Enter a restricted API key" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="SAVE API KEY" Style="{StaticResource PhoneActionButtonStyle}" Click="SaveApiKeyButton_Click" />
                            <Button Content="CLEAR" Style="{StaticResource PhoneOutlineButtonStyle}" Click="ClearApiKeyButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ApiKeyStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PhoneSurfaceBrush}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="google account" Style="{StaticResource PhoneSectionTitleStyle}" />
                        <TextBlock Text="Upload uses a Google TVs and limited-input device OAuth client. No redirect URI is used. Your client secret is stored only in Windows Credential Locker." Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBox x:Name="OAuthClientIdBox" Style="{StaticResource PhoneTextBoxStyle}" Header="Limited-input device OAuth client ID" PlaceholderText="Paste your Google OAuth client ID" />
                        <PasswordBox x:Name="OAuthClientSecretBox" Style="{StaticResource PhonePasswordBoxStyle}" Header="Limited-input device OAuth client secret" PlaceholderText="Paste your Google OAuth client secret" />
                        <TextBlock Text="In Google Auth Platform, create a TVs and limited-input devices client. The code below is entered on another device; it never opens a sign-in form in this app." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="SAVE CLIENT ID" Style="{StaticResource PhoneActionButtonStyle}" Click="SaveOAuthSettingsButton_Click" />
                            <Button Content="SIGN IN" Style="{StaticResource PhoneOutlineButtonStyle}" Click="SignInButton_Click" />
                            <Button x:Name="CancelAuthorizationButton" Content="CANCEL" Style="{StaticResource PhoneOutlineButtonStyle}" Click="CancelAuthorizationButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="VerificationUrlText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="VerificationCodeText" FontSize="24" FontFamily="Segoe UI Semibold" Foreground="{StaticResource PhoneHighlightBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="AuthStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0">
                    <Button Content="ABOUT" Style="{StaticResource PhoneOutlineButtonStyle}" Click="AboutButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
